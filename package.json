{
  "name": "@rivium/auth-web",
  "version": "0.1.1",
  "description": "Rivium Auth SDK for web apps - hosted sign-in for your users",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "pretypecheck": "node scripts/gen-version.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/gen-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "auth",
    "authentication",
    "sign-in",
    "rivium",
    "rivium-auth"
  ],
  "author": "Rivium <support@rivium.co>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rivium-co/rivium_auth_web_sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Rivium-co/rivium_auth_web_sdk/issues"
  },
  "homepage": "https://rivium.co/cloud/rivium-auth",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
